                    <text x="20" y="114" fill="#334155">MUSE（分层记忆自进化）</text>
                    <text x="20" y="136" fill="#334155">DeepAgent（memory folding）</text>

                    <!-- 主线2 技能 -->
                    <rect x="275" y="20" width="230" height="26" rx="8" fill="#dcfce7" stroke="#22c55e"/>
