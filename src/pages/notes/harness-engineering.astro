                        <td class="px-4 py-3 font-medium text-slate-700">后台进程</td>
                        <td class="px-4 py-3"><code>CronCreate</code>、<code>CronDelete</code>、<code>CronList</code></td>
                    </tr>
                    <tr>
                        <td class="px-4 py-3 font-medium text-slate-700">Agent 委派</td>
                        <td class="px-4 py-3"><code>spawn_agent</code>、<code>resume_agent</code>、<code>wait_agent</code>、<code>list_agents</code>、<code>close_agent</code>、<code>interrupt_agent</code> 等</td>
